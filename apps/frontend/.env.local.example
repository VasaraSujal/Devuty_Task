# =============================================================================
# Frontend Environment Configuration
# =============================================================================

# Express API Base URL (including /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Frontend Site URL (used for redirect URLs, OG tags, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Production Configuration
# =============================================================================
# Copy this file to .env.local and update the values below for production:
#
# NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://your-frontend-domain.com
#
# Note: NEXT_PUBLIC_ prefixed variables are exposed to the browser
# =============================================================================
# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection Strings (Supabase / Neon PostgreSQL)
# DATABASE_URL - Connection pooled URL (port 6543 for Supabase with PgBouncer)
# DIRECT_URL - Direct connection URL (port 5432) for Prisma migrations
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# JWT Authentication Secrets (min 32 characters)
JWT_SECRET=super-secret-jwt-key-min-32-characters-long-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-jwt-key-min-32-characters-long

# CORS Configuration (Exact Frontend Origin)
CORS_ORIGIN=http://localhost:3000

# Supabase Storage (Optional - for media uploads)
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=blog-media
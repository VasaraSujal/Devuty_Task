# =============================================================================
# Git Ignore Configuration - Monorepo (Tactyqal Labs / Devuty)
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production & Build Artifacts
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Environment & Secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
!.env.example
!.env.local.example

# Debug & Execution Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Database & Migrations
prisma/migrations/*.lock
*.sqlite
*.sqlite3
*.db

# Temporary, Scraping & Scratch Files
*.tmp
*.bak
*.dump
blog_dump.html
blog_live.html
homepage_dump.html

# Testing & Coverage
coverage/
.nyc_output/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDE / Editor Settings
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
